---
import { baseUrl } from '@/utils/functions';
const logo = baseUrl('/assets/affinity-designer.svg');
---

<section class='am-hero'>
  <h1>
    20 SVG using Affinity Designer
    <img class='am-img' src={logo} alt='Logo' />
  </h1>
</section>
<style>
  .am-img {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 7vmax;
    bottom: -10vmax;
  }

  .am-hero {
    height: 100vh;
    position: relative;
    pointer-events: none;
    z-index: 5;
    overflow-x: hidden;
  }

  h1 {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 5vmax;
    text-align: center;
    font-family: 'Impact', sans-serif;
    text-transform: uppercase;
    user-select: none;
    text-wrap: balance;
    color: transparent;
    background-image: linear-gradient(135deg, #f0f, lime, orange);
    background-clip: text;
    -webkit-text-stroke: 0.005vmax black;
    letter-spacing: 0.1vmax;

    img {
      width: 4vmax;
      transform: translateY(0.3vmax);
    }
  }
</style>
